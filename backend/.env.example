# --- Security (generate with: python3 -c "import secrets; print(secrets.token_hex(32))") ---
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
JWT_HOURS=12

# --- Database (data tier) ---
# Local development (no setup needed):
DATABASE_URL=sqlite:///photoshare.db
# AWS RDS PostgreSQL:
# DATABASE_URL=postgresql://photoshare_admin:PASSWORD@your-db.xxxxx.ap-southeast-1.rds.amazonaws.com:5432/photoshare

# --- Photo storage ---
# local = save files in backend/uploads (development)
# s3    = save files in the S3 bucket (cloud)
STORAGE_BACKEND=local
S3_BUCKET=
AWS_REGION=ap-southeast-1
S3_URL_EXPIRY_SECONDS=3600
MAX_UPLOAD_MB=10

# --- CORS: frontend address allowed to call the API ---
CORS_ORIGINS=*
