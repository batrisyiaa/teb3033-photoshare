# /etc/systemd/system/photoshare.service
# Runs the Flask API with Gunicorn. 3 worker processes handle requests in
# parallel, so several users are served at the same time.
# --preload creates the app (and tables) once before the workers start.
[Unit]
Description=PhotoShare Flask API (Gunicorn)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/photoshare/backend
EnvironmentFile=/opt/photoshare/backend/.env
ExecStart=/opt/photoshare/backend/venv/bin/gunicorn --preload --workers 3 --threads 2 --bind 127.0.0.1:5000 --access-logfile /var/log/photoshare/access.log --error-logfile /var/log/photoshare/error.log wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
